# Give the logged-in user access to Razer (VID 1532) hidraw nodes so razerctl can
# send Protocol25 feature reports without root.  Install:
#   sudo cp udev/99-razerctl.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="1532", TAG+="uaccess", MODE="0660"
# Without OpenRazer the mouse's /dev/input nodes are root:input; razerctl's button
# tester and software remapper read them, so grant the desktop user access there too.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="1532", TAG+="uaccess"
