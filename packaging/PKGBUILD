# Arch / CachyOS package. Build from the project root with:
#   cd packaging && makepkg -si
pkgname=razerctl
pkgver=0.2.0
pkgrel=1
pkgdesc="Razer mouse control for Linux: onboard button remapping, DPI, polling rate (Synapse rewrite in Rust)"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libglvnd' 'libnotify')
optdepends=('openrazer-daemon: battery/DPI via the kernel driver')
makedepends=('cargo')
source=()

build() {
    cd "$startdir/.."
    cargo build --release --locked
}

package() {
    cd "$startdir/.."
    install -Dm755 target/release/razerctl          "$pkgdir/usr/bin/razerctl"
    install -Dm755 target/release/razerctl-gui      "$pkgdir/usr/bin/razerctl-gui"
    install -Dm644 packaging/razerctl.desktop       "$pkgdir/usr/share/applications/razerctl.desktop"
    install -Dm644 packaging/razerctl.svg           "$pkgdir/usr/share/icons/hicolor/scalable/apps/razerctl.svg"
    install -Dm644 udev/70-razerctl.rules           "$pkgdir/usr/lib/udev/rules.d/70-razerctl.rules"
    sed 's|%h/.local/bin/razerctl|/usr/bin/razerctl|' systemd/razerctl-remap.service \
        > razerctl-remap.service.pkg
    install -Dm644 razerctl-remap.service.pkg       "$pkgdir/usr/lib/systemd/user/razerctl-remap.service"
    rm -f razerctl-remap.service.pkg
    sed 's|%h/.local/bin/razerctl|/usr/bin/razerctl|' systemd/razerctl-battery.service \
        > razerctl-battery.service.pkg
    install -Dm644 razerctl-battery.service.pkg     "$pkgdir/usr/lib/systemd/user/razerctl-battery.service"
    rm -f razerctl-battery.service.pkg
    install -Dm644 README.md                        "$pkgdir/usr/share/doc/razerctl/README.md"
    install -Dm644 docs/onboard-button-protocol.md  "$pkgdir/usr/share/doc/razerctl/onboard-button-protocol.md"
}
